{
  "name": "@thepia/flows.thepia.net",
  "type": "module",
  "version": "0.0.2",
  "description": "Public demo website for Thepia Flows with live database integration and passkey authentication",
  "scripts": {
    "dev": "astro dev",
    "dev:flows": "concurrently \"cd ../flows-auth && pnpm build:watch\" \"pnpm dev\"",
    "build": "astro check && astro build",
    "build:watch": "astro build --watch",
    "preview": "astro preview",
    "astro": "astro",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "astro check",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:critical": "vitest run tests/critical",
    "test:e2e": "playwright test",
    "demo:setup": "echo 'Setting up demo environment...'",
    "demo:start": "pnpm dev",
    "demo:reset": "echo 'Resetting demo state...'",
    "deploy:preview": "echo 'Deploying to GitHub Pages...'",
    "deploy:production": "echo 'Deploying to Bunny CDN...'",
    "setup:https": "./scripts/setup-https.sh",
    "setup:letsencrypt": "./scripts/setup-letsencrypt-dev.sh",
    "setup:flows-auth-dev": "./scripts/setup-flows-auth-dev.sh",
    "rebuild:flows-auth": "cd ../flows-auth && pnpm build && cd ../flows.thepia.net && rm -rf node_modules/.vite && rm -rf .astro && rm -rf node_modules/@thepia && pnpm install --force",
    "force-refresh": "./scripts/force-refresh-flows-auth.sh",
    "nuclear-update": "./scripts/nuclear-flows-auth-update.sh",
    "install:with-env": "set -a && [ -f .env ] && . ./.env && set +a && pnpm install"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/svelte": "^9.0.1",
    "@aws-sdk/client-ses": "^3.844.0",
    "@supabase/supabase-js": "^2.50.5",
    "@tailwindcss/vite": "^4.1.10",
    "@thepia/branding": "1.2.1",
    "@thepia/flows-auth": "^1.3.0",
    "astro": "^7.1.0",
    "bits-ui": "^2.8.11",
    "clsx": "^2.1.1",
    "phosphor-astro": "^2.1.0",
    "shadcn-svelte": "^0.14.1",
    "svelte": "^5.55.7",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/svelte": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "jsdom": "^25.0.1",
    "node-fetch": "^3.3.2",
    "phosphor-svelte": "2.0.*",
    "postcss": "^8.5.6",
    "svelte-check": "^4.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
