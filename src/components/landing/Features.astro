---
// Features component - Based on thepia.com/flows use cases
import { Image } from 'astro:assets';
import ConsultingIllustration from '../../assets/illustrations/Consulting_Monochromatic.svg';

// Import Phosphor icons for better semantic meaning and consistency
import ClipboardText from 'phosphor-astro/ClipboardText.astro';    // Employee Offboarding
import ListChecks from 'phosphor-astro/ListChecks.astro';          // Quality Inspections
import Warning from 'phosphor-astro/Warning.astro';                // Incident Reporting
import Gear from 'phosphor-astro/Gear.astro';                      // Equipment Management
import Users from 'phosphor-astro/Users.astro';                    // Employee Onboarding
import Lightning from 'phosphor-astro/Lightning.astro';            // Custom Workflows
import Check from 'phosphor-astro/Check.astro';                    // Feature checkmarks
---

<section class="py-section bg-gray-50 dark:bg-gray-800/50">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="mb-8">
        <div class="relative inline-block">
          <Image
            src={ConsultingIllustration}
            alt="Expert consulting and guidance illustration"
            width={500}
            height={400}
            class="w-full max-w-md mx-auto"
          />
          <!-- Decorative elements -->
          <div class="absolute -top-4 -right-4 w-16 h-16 bg-primary/20 rounded-full"></div>
          <div class="absolute -bottom-4 -left-4 w-12 h-12 bg-primary/30 rounded-full"></div>
        </div>
      </div>
      <h2 class="text-3xl md:text-4xl font-serif mb-6">Perfect For</h2>
      <p class="text-xl text-gray-700 dark:text-gray-300 max-w-3xl mx-auto">
        Thepia Flows transforms complex workplace processes into streamlined mobile experiences
      </p>
    </div>
    
    <!-- Features Grid -->
    <div class="feature-grid">
      <!-- Employee Offboarding -->
      <div class="card-hover">
        <div class="flex items-start mb-4">
          <div class="w-12 h-12 bg-red-100 dark:bg-red-900/50 rounded-xl flex items-center justify-center mr-4">
            <ClipboardText width={24} height={24} class="text-red-600 dark:text-red-400" />
          </div>
          <div>
            <h3 class="text-xl font-medium mb-2">Employee Offboarding</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Equipment return and workspace handover with visual documentation
            </p>
          </div>
        </div>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Asset tracking with photos
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Digital handover checklists
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Automated compliance reporting
          </li>
        </ul>
      </div>
      
      <!-- Quality Inspections -->
      <div class="card-hover">
        <div class="flex items-start mb-4">
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/50 rounded-xl flex items-center justify-center mr-4">
            <ListChecks width={24} height={24} class="text-blue-600 dark:text-blue-400" />
          </div>
          <div>
            <h3 class="text-xl font-medium mb-2">Quality Inspections</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Standardized inspection processes with photo evidence and real-time reporting
            </p>
          </div>
        </div>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Photo-based evidence capture
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            GPS location tracking
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Instant report generation
          </li>
        </ul>
      </div>
      
      <!-- Incident Reporting -->
      <div class="card-hover">
        <div class="flex items-start mb-4">
          <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/50 rounded-xl flex items-center justify-center mr-4">
            <Warning width={24} height={24} class="text-orange-600 dark:text-orange-400" />
          </div>
          <div>
            <h3 class="text-xl font-medium mb-2">Incident Reporting</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Immediate incident capture with photos, witness statements, and automatic escalation
            </p>
          </div>
        </div>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Real-time incident logging
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Automatic notifications
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Compliance documentation
          </li>
        </ul>
      </div>
      
      <!-- Equipment Management -->
      <div class="card-hover">
        <div class="flex items-start mb-4">
          <div class="w-12 h-12 bg-green-100 dark:bg-green-900/50 rounded-xl flex items-center justify-center mr-4">
            <Gear width={24} height={24} class="text-green-600 dark:text-green-400" />
          </div>
          <div>
            <h3 class="text-xl font-medium mb-2">Equipment Management</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Track equipment lifecycle from deployment to maintenance and retirement
            </p>
          </div>
        </div>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            QR code scanning
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Maintenance scheduling
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Asset history tracking
          </li>
        </ul>
      </div>

      <!-- Employee Onboarding -->
      <div class="card-hover">
        <div class="flex items-start mb-4">
          <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/50 rounded-xl flex items-center justify-center mr-4">
            <Users width={24} height={24} class="text-purple-600 dark:text-purple-400" />
          </div>
          <div>
            <h3 class="text-xl font-medium mb-2">Employee Onboarding</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Streamlined new hire processes with document collection and workspace setup
            </p>
          </div>
        </div>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Digital document collection
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Progress tracking
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Automated reminders
          </li>
        </ul>
      </div>

      <!-- Custom Workflows -->
      <div class="card-hover">
        <div class="flex items-start mb-4">
          <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900/50 rounded-xl flex items-center justify-center mr-4">
            <Lightning width={24} height={24} class="text-indigo-600 dark:text-indigo-400" />
          </div>
          <div>
            <h3 class="text-xl font-medium mb-2">Custom Workflows</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Tailored solutions for your unique business processes and requirements
            </p>
          </div>
        </div>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Process analysis
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Custom development
          </li>
          <li class="flex items-center">
            <Check width={16} height={16} class="text-green-500 mr-2" />
            Ongoing optimization
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
