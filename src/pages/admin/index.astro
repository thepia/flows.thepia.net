---
// Admin dashboard - Static prerendered page
// IMPORTANT: This page uses static prerendering (prerender = true)
// flows-auth library uses STATIC IMPORTS, not dynamic imports
// Only /dev/* paths are meant to use SSR
import AdminApp from '../../components/admin/AdminApp.svelte';
import FloatingSupportButton from '../../components/debug/FloatingSupportButton.svelte';
import Layout from '../../layouts/Layout.astro';

// Page metadata
const title = 'Admin Dashboard - Thepia Flows';
const description = 'Administrative interface for managing demo invitations and user permissions.';

export const prerender = true; // Static generation - USE STATIC IMPORTS in components
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <!-- Client-side Svelte Admin App -->
    <AdminApp client:load />
  <FloatingSupportButton client:load />
  </main>
</Layout>